# Copy this file to ".env" and edit it. Never commit .env.
PORT=5000

# Option A - MongoDB installed on your computer (MongoDB Community Server)
MONGODB_URI=mongodb://127.0.0.1:27017/wellbeing_journal

# Option B - MongoDB Atlas (cloud). Paste your own connection string, e.g.
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/wellbeing_journal?retryWrites=true&w=majority

# Allowed browser origin for CORS (the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173
